		{
			"name": "Single Match - New Entity Creation",
			"item": [
				{
					"name": "New Entity: Unknown Company (high threshold)",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Quantum Dynamics Solutions Inc\",\n    \"threshold\": 0.9,\n    \"metadata\": {\n        \"entity_type\": \"COMPANY\",\n        \"industry\": \"Technology\",\n        \"country\": \"USA\"\n    }\n}"
						},
						"url": {
							"raw": "{{base_url}}/match",
							"host": ["{{base_url}}"],
							"path": ["match"]
						},
						"description": "Entity that does NOT exist in the database. With high threshold (0.9) and metadata, should create a new entity. Expect is_new_entity=true and match_type=NEW_ENTITY."
					},
					"response": []
				},
				{
					"name": "New Entity: Verify it now matches",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Quantum Dynamics Solutions\",\n    \"threshold\": 0.6\n}"
						},
						"url": {
							"raw": "{{base_url}}/match",
							"host": ["{{base_url}}"],
							"path": ["match"]
						},
						"description": "Run AFTER 'New Entity: Unknown Company'. The previously created entity should now be found by fuzzy/semantic match."
					},
					"response": []
				},
