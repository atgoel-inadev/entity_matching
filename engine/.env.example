# Snowflake
SNOWFLAKE_ACCOUNT=HLWDCFC-FD80923
SNOWFLAKE_USER=ATGOEL
SNOWFLAKE_PASSWORD=your_password_here
SNOWFLAKE_ROLE=SNOWFLAKE_LEARNING_ROLE
SNOWFLAKE_WAREHOUSE=SNOWFLAKE_LEARNING_WH
SNOWFLAKE_DATABASE=SNOWFLAKE_LEARNING_DB
SNOWFLAKE_SCHEMA=ENTITY_MATCHING

# Redis
REDIS_URL=redis://localhost:6379/0

# Engine
PORT=8001
NODE_ENV=development

# Cache
CACHE_TTL_SECONDS=3600
PROFILE_CACHE_TTL_SECONDS=60
LRU_MAX_PROFILES=100
LRU_MAX_RESULTS=1000

# Resolution defaults
DEFAULT_THRESHOLD=0.65
DEFAULT_CANDIDATE_TOP_K=50
DEFAULT_SEMANTIC_MIN_SIMILARITY=0.4
FAST_PATH_MIN_WEIGHT=3.0
MAX_BATCH_SIZE=50

# Security (optional — leave blank to disable API key auth)
API_KEY=

# Logging
LOG_LEVEL=info
